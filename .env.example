# WhatsApp Cloud API (Vercel Environment Variables)
# Never commit real tokens to git.

WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=ruffneck_verify_change_me
WHATSAPP_ADMIN_SECRET=ruffneck_admin_change_me


# Admin server-side auth (required for /api/admin-login)
ADMIN_PASSWORD=change_this_to_a_strong_password
ADMIN_SECRET=change_this_to_a_long_random_string
