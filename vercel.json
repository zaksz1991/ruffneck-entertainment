  "redirects": [
    {
      "source": "/services/it-support",
      "destination": "/services-it.html",
      "permanent": true
    },
    {
      "source": "/services/training",
      "destination": "/services-training.html",
      "permanent": true
    },
    {
      "source": "/services/career-services",
      "destination": "/services-career.html",
      "permanent": true
    },
    {
      "source": "/services/ai",
      "destination": "/services-ai.html",
      "permanent": true
    },
    {
      "source": "/services/operations",
      "destination": "/services-operations.html",
      "permanent": true
    },
    {
      "source": "/services/digital-growth",
      "destination": "/services-marketing.html",
      "permanent": true
    },
    {
      "source": "/contact-page",
      "destination": "/contact",
      "permanent": false
    },
    {
      "source": "/contact-page.html",
      "destination": "/contact",
      "permanent": false
    },
    {
      "source": "/blog.html",
      "destination": "/blog",
      "permanent": false
    },
    {
      "source": "/store.html",
      "destination": "/store",
      "permanent": false
    },
    {
      "source": "/case-studies.html",
      "destination": "/case-studies",
      "permanent": false
    },
    {
      "source": "/founder.html",
      "destination": "/founder",
      "permanent": false
    },
    {
      "source": "/accessibility.html",
      "destination": "/accessibility",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/blog",
      "destination": "/blog.html"
    },
    {
      "source": "/store",
      "destination": "/store.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/admin/",
      "destination": "/admin.html"
    },
    {
      "source": "/contact",
      "destination": "/contact-page.html"
    },
    {
      "source": "/case-studies",
      "destination": "/case-studies.html"
    },
    {
      "source": "/founder",
      "destination": "/founder.html"
    },
    {
      "source": "/accessibility",
      "destination": "/accessibility.html"
    },
    {
      "source": "/programmes",
      "destination": "/programmes.html"
    },
    {
      "source": "/start-here",
      "destination": "/start-here.html"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/refund",
      "destination": "/refund.html"
    },
    {
      "source": "/delivery-policy",
      "destination": "/delivery-policy.html"
    },
    {
      "source": "/faq",
      "destination": "/faq.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/(.*)\\.(js|css|png|jpg|jpeg|gif|svg|webp|avif|ico|woff|woff2)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}